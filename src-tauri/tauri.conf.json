{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asterium",
  "version": "0.3.0",
  "identifier": "pro.asterium.prestarter",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Asterium",
        "width": 512,
        "height": 300,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "transparent": true,
        "incognito": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["appimage", "app"],
    "category": "Game",
    "shortDescription": "Asterium",
    "longDescription": "Installs Java for the Asterium launcher and starts it.",
    "copyright": "Asterium",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
